# Generate a local .env using: python setup/init-environment.py
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
HF_HOME=../.cache/huggingface

# Added automatically by setup/configure-app.py for local development.
JWT_SECRET=
ENABLE_DEMO=true
COOKIE_SECURE=false
# Production requires COOKIE_SECURE=true, ENABLE_DEMO=false, TLS and backups.
# Optional: GITHUB_TOKEN, GITHUB_REPOSITORY, ANALYTICS_DATABASE_URL,
# NEO4J_URI, OTEL_EXPORTER_OTLP_ENDPOINT. Do not put credentials in frontend config.
