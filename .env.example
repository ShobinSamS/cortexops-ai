# Generate a local .env using: python setup/init-environment.py
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
HF_HOME=../.cache/huggingface

# Added automatically by setup/configure-app.py for local development.
JWT_SECRET=
ENABLE_DEMO=true
COOKIE_SECURE=false
# Production requires COOKIE_SECURE=true, ENABLE_DEMO=false, TLS and backups.
# Optional: GITHUB_TOKEN, GITHUB_REPOSITORY, ANALYTICS_DATABASE_URL,
# NEO4J_URI, OTEL_EXPORTER_OTLP_ENDPOINT. Do not put credentials in frontend config.

# Generated by configure-app.py. Never commit real values.
ANALYTICS_PASSWORD=
GRAFANA_PASSWORD=
# Optional native connection overrides:
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=cortexops
# POSTGRES_USER=cortexops
# DATABASE_URL=
# ANALYTICS_DATABASE_URL=
# REDIS_URL=redis://127.0.0.1:6379/0
# QDRANT_URL=http://127.0.0.1:6333
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo
# GITHUB_WORKSPACE_ID=
# NEO4J_URI=bolt://127.0.0.1:7687
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Compose optional-profile endpoints (also configurable in the invoking shell):
# CONTAINER_NEO4J_URI=bolt://neo4j:7687
# CONTAINER_OTEL_ENDPOINT=http://otel-collector:4318
# Execution/resource settings:
# LLM_TIMEOUT=420
# INVESTIGATION_TIMEOUT=1200
# MAX_LLM_CALLS=6
# MAX_TOOL_CALLS=24
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=200
# RETRIEVAL_MIN_SCORE=-6
# MAX_UPLOAD_BYTES=20971520
